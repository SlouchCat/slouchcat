# Copy to .env (next to compose.yaml) and adjust.

# Host folder with the media libraries, mounted read-only at /media.
MEDIA_DIR=/srv/media

# User and group the server runs as; must own ./config and ./cache.
PUID=1000
PGID=1000

# Numeric GID of the host group "render" (Intel/AMD only): getent group render | cut -d: -f3
RENDER_GID=992

# Time zone (schedules, log timestamps).
TZ=Europe/Zurich
