# Copy to .env (next to compose.yaml) and adjust.

# Version of the published image (ghcr.io/slouchcat/slouchcat). Change it and run
# `docker compose pull && docker compose up -d` to update.
SLOUCHCAT_VERSION=1.3.0

# Host folder with the media libraries, mounted read-only at /media.
MEDIA_DIR=/srv/media

# User and group the server runs as; must own ./config and ./cache.
PUID=1000
PGID=1000

# Numeric GID of the host group "render" (Intel/AMD only): getent group render | cut -d: -f3
RENDER_GID=992

# Time zone (schedules, log timestamps).
TZ=Europe/Zurich

# Optional: TMDB v4 read access token (themoviedb.org → Settings → API). Overrides the key stored by
# the wizard. Never commit this file.
SLOUCHCAT_TMDB_API_KEY=

# Optional: TheTVDB v4 API key (thetvdb.com → Dashboard → API Keys) and, for a user-supported key, the
# subscriber PIN. Series are looked up there only when TMDB finds nothing. Empty = TVDB is not used.
SLOUCHCAT_TVDB_API_KEY=
SLOUCHCAT_TVDB_PIN=

# Optional: YouTube Data API v3 key for trailers that TMDB does not list (free, 10'000 units per day,
# that is about 100 searches). In the Google Cloud console (console.cloud.google.com) create a new
# project and enable "YouTube Data API v3" under "APIs & Services → Library". Then open "Credentials",
# choose "Create credentials → API key" and paste the key here. Empty = trailers come from TMDB only.
SLOUCHCAT_YOUTUBE_API_KEY=
# Trakt Client ID (M7): öffentliche Listen für die Reihe «Spotlight» auf der Startseite. Unter
# https://trakt.tv/oauth/applications eine App anlegen (Redirect URI urn:ietf:wg:oauth:2.0:oob); nur die
# Client ID eintragen, das Secret bleibt ungenutzt. Welche Liste Spotlight zeigt, steht in der
# Verwaltung unter «Spotlight». Leer: die Reihe bleibt ausgeblendet.
SLOUCHCAT_TRAKT_CLIENT_ID=

# AI step of the trailer search; "off" is the only value in this version.
SLOUCHCAT_TRAILER_AI=off

# AniList as a metadata source for anime folders (no key needed); "off" switches it off server-wide,
# the ticks on the folders stay.
SLOUCHCAT_ANILIST=on

# E-Mail-Server für Benachrichtigungen (M8, optional): Host, Port, Benutzer, Passwort und Absender stehen
# beim eigenen Mail-Anbieter (Hilfeseite «SMTP» oder «Mailprogramm einrichten»). SLOUCHCAT_SMTP_TLS ist
# starttls (Standard, Port 587), tls (Port 465) oder none. Leer: der Hauptbenutzer kann den Server in der
# Verwaltung hinterlegen, sonst gibt es keine E-Mails.
SLOUCHCAT_SMTP_HOST=
SLOUCHCAT_SMTP_PORT=
SLOUCHCAT_SMTP_USER=
SLOUCHCAT_SMTP_PASSWORD=
SLOUCHCAT_SMTP_FROM=
SLOUCHCAT_SMTP_TLS=

# Telegram-Bot für Benachrichtigungen (M8, optional): in Telegram dem Konto @BotFather «/newbot» senden und
# das erhaltene Token hier eintragen. Leer: der Hauptbenutzer kann es in der Verwaltung hinterlegen, sonst
# steht Telegram nicht zur Wahl.
SLOUCHCAT_TELEGRAM_BOT_TOKEN=

# Öffentliche Adresse dieses Servers für Links in E-Mails und Nachrichten (M8, optional), zum Beispiel die
# Adresse des https-Profils. Leer: die Adresse aus der Verwaltung, sonst Nachrichten ohne Link.
SLOUCHCAT_PUBLIC_URL=

# HTTPS with Caddy (compose profile "https", README): public host name of this server. DNS must point
# to this host and ports 80 and 443 must be forwarded. "localhost" uses Caddy's internal CA (tests).
SLOUCHCAT_DOMAIN=localhost

# E-mail address for the Let's Encrypt account (expiry notices); optional but recommended.
ACME_EMAIL=

# Die Ordner, die der Ordner-Browser im Bibliotheksformular auflisten darf und unter denen ein neuer
# Bibliotheksordner liegen muss, komma-getrennt. Leer lassen: dann gilt /media, also genau der Ordner,
# den MEDIA_DIR oben in den Container hängt. Setze die Variable nur, wenn du eine zweite Einhängung in
# compose.yaml ergänzt hast. Nimm nie "/" auf: der Browser zeigte dann den ganzen Container, und eine
# Bibliothek liesse sich auf /config mit Datenbank, Sicherungen und secret.key anlegen. Der Server warnt
# beim Start, wenn er "/" hier sieht.
SLOUCHCAT_BROWSE_ROOTS=

# Which proxies may set X-Forwarded-For: empty = nobody (the address of the TCP peer counts);
# "private" = RFC 1918 networks, loopback and fc00::/7; otherwise a comma-separated CIDR list.
# Leave it empty unless a reverse proxy sits in front. For the https profile set "private" TOGETHER WITH
# compose.https-only.yaml (docker compose -f compose.yaml -f compose.https-only.yaml --profile https up -d):
# Prefer Caddy's own Docker network as a CIDR -- `docker network inspect slouchcat_default` prints it,
# usually 172.18.0.0/16. "private" also works but trusts every sender in a private network, which
# includes every device in your home: with port 8096 still published, one of them could set
# X-Forwarded-For itself and so empty the limit on login attempts. The server warns at startup when
# it sees a whole private network here.
SLOUCHCAT_TRUSTED_PROXIES=
