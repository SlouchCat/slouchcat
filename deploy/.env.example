# Copy to .env (next to compose.yaml) and adjust.

# Host folder with the media libraries, mounted read-only at /media.
MEDIA_DIR=/srv/media

# User and group the server runs as; must own ./config and ./cache.
PUID=1000
PGID=1000

# Numeric GID of the host group "render" (Intel/AMD only): getent group render | cut -d: -f3
RENDER_GID=992

# Time zone (schedules, log timestamps).
TZ=Europe/Zurich

# Optional: TMDB v4 read access token (themoviedb.org → Settings → API). Overrides the key stored by
# the wizard. Never commit this file.
SLOUCHCAT_TMDB_API_KEY=

# Optional: TheTVDB v4 API key (thetvdb.com → Dashboard → API Keys) and, for a user-supported key, the
# subscriber PIN. Series are looked up there only when TMDB finds nothing. Empty = TVDB is not used.
SLOUCHCAT_TVDB_API_KEY=
SLOUCHCAT_TVDB_PIN=

# Optional: YouTube Data API v3 key for trailers that TMDB does not list (free, 10'000 units per day,
# that is about 100 searches). In the Google Cloud console (console.cloud.google.com) create a new
# project and enable "YouTube Data API v3" under "APIs & Services → Library". Then open "Credentials",
# choose "Create credentials → API key" and paste the key here. Empty = trailers come from TMDB only.
SLOUCHCAT_YOUTUBE_API_KEY=

# AI step of the trailer search; "off" is the only value in this version.
SLOUCHCAT_TRAILER_AI=off

# HTTPS with Caddy (compose profile "https", README): public host name of this server. DNS must point
# to this host and ports 80 and 443 must be forwarded. "localhost" uses Caddy's internal CA (tests).
SLOUCHCAT_DOMAIN=localhost

# E-mail address for the Let's Encrypt account (expiry notices); optional but recommended.
ACME_EMAIL=

# Which proxies may set X-Forwarded-For: empty = nobody (the address of the TCP peer counts);
# "private" = RFC 1918 networks, loopback and fc00::/7; otherwise a comma-separated CIDR list.
# Leave it empty unless a reverse proxy sits in front. For the https profile set "private" TOGETHER WITH
# compose.https-only.yaml (docker compose -f compose.yaml -f compose.https-only.yaml --profile https up -d):
# "private" trusts every sender in a private network, so port 8096 must not be reachable by LAN clients
# that you do not trust. Otherwise name the proxy's address or Docker network as a CIDR.
SLOUCHCAT_TRUSTED_PROXIES=
