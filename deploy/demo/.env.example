# Environment of the demo server (deploy/demo/README.md). Copy to .env and fill in.
# Values for e-mail and password: no spaces, quotes or backslashes; passwords at least 10 characters.
# A random password: openssl rand -base64 24 | tr -d '/+='

# Main account (administrator). Keep it for yourself; Google's reviewers never get it.
DEMO_OWNER_EMAIL=<E-Mail-Adresse des Hauptkontos>
DEMO_OWNER_PASSWORD=<Passwort des Hauptkontos>

# Review account: goes into the Play Console («App access»). No administration rights.
DEMO_REVIEW_EMAIL=<E-Mail-Adresse des Prüfkontos>
DEMO_REVIEW_PASSWORD=<Passwort des Prüfkontos>
DEMO_REVIEW_PROFILE=Demo
# Interface language of both accounts (en for Google's reviewers).
DEMO_LANGUAGE=en

# Server image. The apps need contract 1.42.0 or newer (app sign-in); use the version the app
# under review expects (docs/dev/VERTRAEGLICHKEIT.md). 1.41.3 starts as well, but no app signs in.
SLOUCHCAT_VERSION=1.42.0

# Where the server listens on the host. Local probe: 127.0.0.1 and 8797.
# Rented server with the https profile: 127.0.0.1 (only Caddy reaches it).
DEMO_BIND=127.0.0.1
DEMO_PORT=8797

# Media: blender = download the open movies (about 1.6 GB); local = use what is in DEMO_MEDIA_DIR.
DEMO_SOURCE=blender
DEMO_MEDIA_DIR=./media

# Optional: TMDB v4 read access token for posters and descriptions.
SLOUCHCAT_TMDB_API_KEY=

# HTTPS on a rented server: uncomment the next five lines.
# COMPOSE_PROFILES=https
# DEMO_DOMAIN=<Name des Vorführservers, zum Beispiel demo.example.org>
# ACME_EMAIL=<E-Mail-Adresse für Let's Encrypt>
# SLOUCHCAT_PUBLIC_URL=https://<Name des Vorführservers>
# SLOUCHCAT_TRUSTED_PROXIES=private

# User and group that own ./config, ./cache and ./media.
PUID=1000
PGID=1000
TZ=Europe/Zurich
