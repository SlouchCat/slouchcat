# TLS front end of the push forwarder on a rented server (compose profile "tls", concept 27
# section 7.5). On own hardware the existing reverse proxy terminates TLS instead.
#
# Environment (from .env):
#   RELAY_NAMES  the names this instance answers to, comma-separated: the fixed name, and during a
#                move the probe name ("push.slouchcat.com, push-probe.example.test"). Each one
#                must also be an origin in RELAY_PUSH_ORIGINS, or the VAPID check refuses (D-4).
#   RELAY_TLS    an e-mail address: certificates from Let's Encrypt via ACME (ports 80 and 443
#                must be reachable); "internal": certificates from Caddy's own local CA (tests and
#                the local move rehearsal).
{
	# D-5: no caller addresses in logs. Caddy writes no access log unless a site asks for one;
	# its error log, the reverse proxy's log and the standard library's TLS messages carry the
	# remote address, so they are left out.
	log default {
		exclude http.log.error http.log.access http.handlers.reverse_proxy http.stdlib
	}
}

{$RELAY_NAMES} {
	tls {$RELAY_TLS}
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 64KB
	}
	# Caddy sets X-Forwarded-For itself; the service trusts it from this container's fixed
	# address only (RELAY_TRUSTED_PROXIES, D-9).
	reverse_proxy push:8080
}
