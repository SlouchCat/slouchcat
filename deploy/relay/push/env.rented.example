# Push forwarder on a rented server with its own TLS front end (concept 27 section 7.5).
# Copy to .env next to compose.yaml. docs/relay/BETRIEB.md explains every value.

RELAY_VERSION=1.0.0

# The profile "tls" starts the TLS front end in this stack.
COMPOSE_PROFILES=tls

# The port of the service stays on the loopback address; from outside only 80 and 443 of the
# TLS front end are reachable.
RELAY_BIND=127.0.0.1
RELAY_PORT=8181

# The fixed name, and during a move also the probe name (step 3), comma-separated. Every name
# here is an origin in RELAY_PUSH_ORIGINS as well.
RELAY_NAMES=push.slouchcat.com
RELAY_PUSH_ORIGINS=https://push.slouchcat.com
# An e-mail address for the ACME account (Let's Encrypt), or "internal" for a local test CA.
RELAY_TLS=ops@example.test
#RELAY_TLS_HTTP_PORT=80
#RELAY_TLS_HTTPS_PORT=443

# The TLS front end runs in the host's network and sees the callers' real IPv4 and IPv6
# addresses. Its connections to the service arrive from the gateway of the stack's network, so
# the gateway is the one trusted proxy (D-9).
RELAY_SUBNET=172.30.90.0/29
RELAY_GATEWAY=172.30.90.1
RELAY_TRUSTED_PROXIES=172.30.90.1

# The two secrets, copied from the old place: firebase.json and sealing-keys.json, owned by
# 65532:65532, mode 0400.
RELAY_SECRETS_DIR=./secrets

RELAY_LOG_FORMAT=json
RELAY_LOG_LEVEL=info
