# Push forwarder on own hardware, behind the existing reverse proxy (concept 27, E-22).
# Copy to .env next to compose.yaml. docs/relay/BETRIEB.md explains every value.

RELAY_VERSION=1.0.0

# No profile: the existing reverse proxy terminates TLS for push.slouchcat.com.
COMPOSE_PROFILES=

# The address and port the reverse proxy connects to (this machine's LAN address). Only the
# reverse proxy may reach it: a firewall rule (BETRIEB.md 1.1) or the separate network of R-3.
RELAY_BIND=192.0.2.21
RELAY_PORT=8181

# The one address of the reverse proxy, as the container sees it (D-9). No whole range.
RELAY_TRUSTED_PROXIES=192.0.2.10

# The forwarder's own origins: the aud of every VAPID signature must be one of them (D-4). The
# fixed name first; during a move the probe name of the new instance is added there.
RELAY_PUSH_ORIGINS=https://push.slouchcat.com

# The two secrets: firebase.json and sealing-keys.json in this folder, owned by 65532:65532,
# mode 0400.
RELAY_SECRETS_DIR=./secrets
#RELAY_USER=65532:65532

RELAY_LOG_FORMAT=json
RELAY_LOG_LEVEL=info

# Size and limits (D-2). RELAY_PUSH_MAX_BODY is the largest Web Push body in bytes; Google takes
# 4096 bytes of data, and base64 makes a third more of it.
#RELAY_PUSH_MAX_BODY=2700
#RELAY_RATE=20
#RELAY_BURST=200
#RELAY_PUSH_ADDRESS_RATE=0.5
#RELAY_PUSH_ADDRESS_BURST=20
#RELAY_PUSH_REGISTER_RATE=0.2
#RELAY_PUSH_REGISTER_BURST=10
#RELAY_NET_RATE=200
#RELAY_NET_BURST=2000
#RELAY_PUSH_REGISTER_NET_RATE=2
#RELAY_PUSH_REGISTER_NET_BURST=100
#RELAY_PUSH_GLOBAL_RATE=2000
#RELAY_PUSH_GLOBAL_BURST=4000
