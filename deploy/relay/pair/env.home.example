# Meeting point service on own hardware, behind the existing reverse proxy (concept 27, E-22).
# Copy to .env next to compose.yaml. docs/relay/BETRIEB.md explains every value.

RELAY_VERSION=1.0.0

# No profile: the existing reverse proxy terminates TLS for pair.slouchcat.com.
COMPOSE_PROFILES=

# The address and port the reverse proxy connects to (this machine's LAN address).
RELAY_BIND=192.0.2.20
RELAY_PORT=8180

# The one address of the reverse proxy, as the container sees it (D-9). No whole range.
RELAY_TRUSTED_PROXIES=192.0.2.10

RELAY_LOG_FORMAT=json
RELAY_LOG_LEVEL=info

# Limits (D-2); the defaults fit a few thousand set-ups a day.
#RELAY_PAIR_MAX_OPEN=10000
#RELAY_PAIR_MAX_OPEN_PER_CALLER=10
#RELAY_RATE=2
#RELAY_BURST=30
