-d
--name
slouchcat-updater-self-update
--network
none
-v
/var/run/docker.sock:/var/run/docker.sock
-v
/srv/slouchcat/deploy:/srv/slouchcat/deploy
--mount
type=tmpfs,dst=/srv/slouchcat/deploy/config,readonly,tmpfs-size=4096
--mount
type=tmpfs,dst=/srv/slouchcat/deploy/cache,readonly,tmpfs-size=4096
-e
SLOUCHCAT_DEPLOY_DIR=/srv/slouchcat/deploy
-e
PUID=568
-e
PGID=569
-e
TZ=Europe/Zurich
--entrypoint
/usr/local/bin/slouchcat-updater
ghcr.io/slouchcat/slouchcat-updater@sha256:2222222222222222222222222222222222222222222222222222222222222222
self-update
--project
slouchcat
--workdir
/srv/slouchcat/deploy
-f
/srv/slouchcat/deploy/compose.yaml
-f
/srv/slouchcat/deploy/compose.updater.yaml
--env-file
/srv/slouchcat/deploy/.env
--service
updater
--env
/srv/slouchcat/deploy/.env
--backup
.env.bak-vor-updater-1.18.0
--old-version
1.17.0
--container
slouchcat-updater
