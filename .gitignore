# oh-my-claudecode runtime state
.omc/

# Claude Code local permissions and worktrees
.claude/settings.local.json
.claude/worktrees/

# Real media pictures of mockups: a folder or a link named img (scripts/design-media.sh), never in git
docs/planning/mockups/*/img

# Dependencies and build output
node_modules/
web/dist/
web/storybook-static/
packages/*/dist/
server/bin/
relay/bin/
# Secrets of a local push forwarder run (deploy/relay/push/secrets/), never committed
deploy/relay/push/secrets/*
!deploy/relay/push/secrets/.gitkeep
# `go build ./cmd/<name>` inside server/ without -o leaves the binary here
/server/updater
/server/slouchcat
server/internal/webassets/dist/*
!server/internal/webassets/dist/.gitkeep
coverage/
*.out

# Local runtime data
/config/
/cache/
testdata/media/
.env
# Runtime data of a local demo server run (deploy/demo/README.md)
deploy/demo/config/
deploy/demo/cache/
deploy/demo/media/

# Local dev runtime (task dev)
.dev/

# Taskfile cache
.task/

# Merged Playwright report of the CI shards (`playwright merge-reports`, gate job of ci.yml)
web/playwright-report/
blob-reports/

# Python bytecode of the measurement scripts
__pycache__/
