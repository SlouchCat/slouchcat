<?xml version="1.0" encoding="utf-8"?>
<!-- The TV app (concept 26). The checklist of the K26 stage 0 report, section 8: LEANBACK_LAUNCHER,
     banner 320 x 180, no touchscreen and no other hardware required, landscape, no exported deep
     link (a pairing code never arrives as a link, K-5). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- TV-MT: a TV has no touchscreen. Leanback required: the TV app is an artifact of its own on
         the Android TV track of the phone app's store entry (E-20) and must never reach a phone, where
         its higher versionCode would win over the phone app. required="false" is for one artifact
         that runs on both ("Declare TV device support", developer.android.com, read 23 November 2026;
         ADR 0039, addendum of 23 November 2026). scripts/android-dist.sh checks both in the APK. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The search asks whether the TV offers voice input (concept 26, 3.4): visible to the app
         only with this query (package visibility, Android 11+). No permission: the system's
         recognizer records, the app gets only the text. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- Plain HTTP as on the phone (F-6, E-18): the warning comes on the setup page outside the home
         network; «Server weist sich aus» guards every request to a server over HTTP. -->
    <application
        android:name=".TvApplication"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
