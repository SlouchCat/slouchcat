<?xml version="1.0" encoding="utf-8"?>
<!-- The TV app (concept 26). The checklist of the K26 stage 0 report, section 8: LEANBACK_LAUNCHER,
     banner 320 x 180, no touchscreen and no other hardware required, landscape, no exported deep
     link (a pairing code never arrives as a link, K-5). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- TV-MT: a TV has no touchscreen. Leanback declared but not required: one store entry with the
         phone app (E-20); the TV artifact is the one with LEANBACK_LAUNCHER. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Plain HTTP as on the phone (F-6, E-18): the warning comes on the setup page outside the home
         network; «Server weist sich aus» guards every request to a server over HTTP. -->
    <application
        android:name=".TvApplication"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
