{
  "name": "@slouchcat/api-client",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Typed Slouchcat API client generated from api/openapi.yaml.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi.yaml --output src/generated/schema.d.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
