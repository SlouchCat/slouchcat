{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI Variable",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Interim system stack; the self-hosted variable font is chosen in M1b."
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
      },
      "ja": {
        "$value": ["Hiragino Sans", "Yu Gothic UI", "Noto Sans JP", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI Variable", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "Japanese under :lang(ja) (concept 22, 4.4): Japanese glyphs, not the Chinese forms of the same code points."
      },
      "zh-CN": {
        "$value": ["PingFang SC", "Microsoft YaHei", "Noto Sans SC", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI Variable", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "Simplified Chinese under :lang(zh-CN) (concept 22, 4.4)."
      },
      "zh-TW": {
        "$value": ["PingFang TC", "Microsoft JhengHei", "Noto Sans TC", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI Variable", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "Traditional Chinese under :lang(zh-TW) (concept 22, 4.4)."
      },
      "ko": {
        "$value": ["Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI Variable", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "Korean under :lang(ko) (concept 22, 4.4), with word-break: keep-all in global.css."
      }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.5rem" },
      "2xl": { "$value": "2rem" },
      "3xl": { "$value": "2.75rem" },
      "display": { "$value": "3.75rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.1 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.5 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "display": { "$value": "-0.02em", "$description": "Slightly tightened for large titles." },
      "normal": { "$value": "0em" },
      "caps": { "$value": "0.06em", "$description": "Small uppercase labels." }
    }
  }
}
